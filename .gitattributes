# Normalize line endings in the repository; check out PowerShell files with CRLF
# on Windows so they behave like files created in Windows editors.
* text=auto

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.ps1xml text eol=crlf

*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.csv   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.zip   binary
